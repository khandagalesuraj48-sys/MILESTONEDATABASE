<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InterviewTracker.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:InterviewTracker.Converters"
    xmlns:models="using:InterviewTracker.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:StatusToBrushConverter x:Key="StatusToBrush" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header row -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Dashboard" Style="{ThemeResource TitleLargeTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.LastRefreshed, Mode=OneWay}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Margin="0,4,0,0" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Content="⟳  Refresh"
                    Command="{x:Bind ViewModel.LoadDashboardCommand}"
                    IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- Loading indicator -->
            <ProgressRing
                Grid.Row="1"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                HorizontalAlignment="Center"
                Width="48" Height="48"
                Margin="0,8,0,8" />

            <!-- Error InfoBar -->
            <InfoBar
                Grid.Row="1"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Severity="Error"
                Title="Error"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Margin="0,0,0,12" />

            <!-- Stat tiles -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total -->
                <Border Grid.Column="0" Style="{StaticResource StatTileStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Total Interviews" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}"
                                   FontSize="36" FontWeight="Bold" Margin="0,4,0,4" />
                        <TextBlock Text="All candidates" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Selected -->
                <Border Grid.Column="1" Style="{StaticResource StatTileStyle}" Margin="4,0,4,0"
                        BorderBrush="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="Selected" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}"
                                   FontSize="36" FontWeight="Bold" Margin="0,4,0,4"
                                   Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="Hired candidates" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Rejected -->
                <Border Grid.Column="2" Style="{StaticResource StatTileStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Rejected" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.RejectedCount, Mode=OneWay}"
                                   FontSize="36" FontWeight="Bold" Margin="0,4,0,4"
                                   Foreground="{StaticResource DangerBrush}" />
                        <TextBlock Text="Not selected" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Pending -->
                <Border Grid.Column="3" Style="{StaticResource StatTileStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Pending" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.PendingCount, Mode=OneWay}"
                                   FontSize="36" FontWeight="Bold" Margin="0,4,0,4"
                                   Foreground="{StaticResource WarningBrush}" />
                        <TextBlock Text="Awaiting decision" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent Candidates -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Recent Candidates"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0,0,0,12" />

                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.RecentCandidates, Mode=OneWay}"
                        SelectionMode="None"
                        MaxHeight="480">
                        <ListView.Header>
                            <Grid Padding="8,4" Background="{ThemeResource SystemFillColorSolidNeutralBackgroundBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ID" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="Date" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="2" Text="Candidate Name" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="3" Text="Position" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="5" Text="Actions" FontWeight="SemiBold" FontSize="12" />
                            </Grid>
                        </ListView.Header>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Candidate">
                                <Grid Padding="8,6" BorderThickness="0,0,0,1"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind InterviewId}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind InterviewDate}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind CandidateName}" FontSize="13"
                                               FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind PositionAppliedFor}" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                    <Border Grid.Column="4" CornerRadius="4" Padding="8,2"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{x:Bind FinalStatus, Converter={StaticResource StatusToBrush}}">
                                        <TextBlock Text="{x:Bind FinalStatus}" FontSize="11"
                                                   Foreground="White" />
                                    </Border>

                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Tag="{x:Bind InterviewId}" Click="ViewButton_Click"
                                                Style="{ThemeResource AccentButtonStyle}" Padding="8,4" FontSize="12">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE7B3;" FontSize="12" />
                                                <TextBlock Text="View" />
                                            </StackPanel>
                                        </Button>
                                        <Button Tag="{x:Bind InterviewId}" Click="EditButton_Click"
                                                Padding="8,4" FontSize="12">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                                <TextBlock Text="Edit" />
                                            </StackPanel>
                                        </Button>
                                        <Button Tag="{x:Bind InterviewId}" Click="WhatsAppButton_Click"
                                                Padding="8,4" FontSize="12"
                                                Background="#25D366" Foreground="White">
                                            <TextBlock Text="WhatsApp" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>

