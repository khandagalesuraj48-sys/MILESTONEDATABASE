<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InterviewTracker.Views.NewInterviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:InterviewTracker.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Page title -->
            <TextBlock Grid.Row="0" Text="New Interview" Style="{ThemeResource TitleLargeTextBlockStyle}"
                       Margin="0,0,0,20" />

            <!-- PDF Picker Card -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Resume Upload" Style="{StaticResource SectionHeaderStyle}" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="PickPdfButton" Click="PickPdfButton_Click"
                                Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A5;" FontSize="16" />
                                <TextBlock Text="Select PDF Resume" />
                            </StackPanel>
                        </Button>

                        <StackPanel VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.HasFile, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Bind ViewModel.SelectedFileName, Mode=OneWay}"
                                       FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedFileSize, Mode=OneWay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- AI Stage message -->
                    <StackPanel Visibility="{x:Bind ViewModel.HasFile, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsProcessingAi, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsProcessingAi, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                          Width="20" Height="20" />
                            <TextBlock Text="{x:Bind ViewModel.AiStageMessage, Mode=OneWay}"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{StaticResource PrimaryBrush}" />
                        </StackPanel>

                        <InfoBar IsOpen="{x:Bind ViewModel.AiError, Mode=OneWay}"
                                 Severity="Warning"
                                 Title="AI Extraction Warning"
                                 Message="{x:Bind ViewModel.AiErrorMessage, Mode=OneWay}"
                                 Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Form Card -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel Spacing="0">
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Candidate Details" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="4" Height="16" CornerRadius="2" Background="{StaticResource AiFieldBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="AI Extracted" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="4" Height="16" CornerRadius="2" Background="{StaticResource ManualFieldBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Manual Entry" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Two-column form grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Candidate Name (AI) | Interview Date -->
                        <Border Grid.Row="0" Grid.Column="0" BorderThickness="3,0,0,0"
                                BorderBrush="{StaticResource AiFieldBrush}" Padding="8,0,0,0" Margin="0,0,0,12">
                            <TextBox Header="Candidate Name *"
                                     Text="{x:Bind ViewModel.CandidateName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Auto-filled from resume" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2" BorderThickness="3,0,0,0"
                                BorderBrush="{StaticResource ManualFieldBrush}" Padding="8,0,0,0" Margin="0,0,0,12">
                            <TextBox Header="Interview Date" PlaceholderText="YYYY-MM-DD"
                                     Text="{x:Bind ViewModel.InterviewDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>

                        <!-- Mobile (AI) | Position -->
                        <Border Grid.Row="1" Grid.Column="0" BorderThickness="3,0,0,0"
                                BorderBrush="{StaticResource AiFieldBrush}" Padding="8,0,0,0" Margin="0,0,0,12">
                            <TextBox Header="Mobile No. *"
                                     Text="{x:Bind ViewModel.MobileNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Auto-filled from resume" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" BorderThickness="3,0,0,0"
                                BorderBrush="{StaticResource ManualFieldBrush}" Padding="8,0,0,0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Position Applied For *" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox HorizontalAlignment="Stretch" IsEditable="True"
                                          x:Name="PositionCombo"
                                          ItemsSource="{x:Bind ViewModel.PositionOptions, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Education (AI) | Department -->
                        <Border Grid.Row="2" Grid.Column="0" BorderThickness="3,0,0,0"
                                BorderBrush="{StaticResource AiFieldBrush}" Padding="8,0,0,0" Margin="0,0,0,12">
                            <TextBox Header="Education / Qualification"
                                     Text="{x:Bind ViewModel.EducationQualification, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Auto-filled from resume" />
                        </Border>
                        <Border Grid.Row="2" Grid.Column="2" BorderThickness="3,0,0,0"
                                BorderBrush="{StaticResource ManualFieldBrush}" Padding="8,0,0,0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Department *" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox HorizontalAlignment="Stretch" IsEditable="True"
                                          x:Name="DepartmentCombo"
                                          ItemsSource="{x:Bind ViewModel.DepartmentOptions, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Experience (AI) | Location -->
                        <Border Grid.Row="3" Grid.Column="0" BorderThickness="3,0,0,0"
                                BorderBrush="{StaticResource AiFieldBrush}" Padding="8,0,0,0" Margin="0,0,0,12">
                            <TextBox Header="Total Experience (Years)"
                                     Text="{x:Bind ViewModel.TotalExperienceYears, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Auto-filled from resume" />
                        </Border>
                        <Border Grid.Row="3" Grid.Column="2" BorderThickness="3,0,0,0"
                                BorderBrush="{StaticResource ManualFieldBrush}" Padding="8,0,0,0" Margin="0,0,0,12">
                            <TextBox Header="Current Location"
                                     Text="{x:Bind ViewModel.CurrentLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="City / State" />
                        </Border>

                        <!-- Current Salary | Expected Salary -->
                        <Border Grid.Row="4" Grid.Column="0" BorderThickness="3,0,0,0"
                                BorderBrush="{StaticResource ManualFieldBrush}" Padding="8,0,0,0" Margin="0,0,0,12">
                            <TextBox Header="Current Salary"
                                     Text="{x:Bind ViewModel.CurrentSalary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="e.g. 5 LPA" />
                        </Border>
                        <Border Grid.Row="4" Grid.Column="2" BorderThickness="3,0,0,0"
                                BorderBrush="{StaticResource ManualFieldBrush}" Padding="8,0,0,0" Margin="0,0,0,12">
                            <TextBox Header="Expected Salary"
                                     Text="{x:Bind ViewModel.ExpectedSalary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="e.g. 8 LPA" />
                        </Border>

                        <!-- Notice Period | Joining Availability -->
                        <Border Grid.Row="5" Grid.Column="0" BorderThickness="3,0,0,0"
                                BorderBrush="{StaticResource ManualFieldBrush}" Padding="8,0,0,0" Margin="0,0,0,12">
                            <TextBox Header="Notice Period"
                                     Text="{x:Bind ViewModel.NoticePeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="e.g. 30 days" />
                        </Border>
                        <Border Grid.Row="5" Grid.Column="2" BorderThickness="3,0,0,0"
                                BorderBrush="{StaticResource ManualFieldBrush}" Padding="8,0,0,0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Joining Availability" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          x:Name="JoiningAvailCombo"
                                          ItemsSource="{x:Bind ViewModel.JoiningAvailabilityOptions, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Technical Knowledge | Recommendation -->
                        <Border Grid.Row="6" Grid.Column="0" BorderThickness="3,0,0,0"
                                BorderBrush="{StaticResource ManualFieldBrush}" Padding="8,0,0,0" Margin="0,0,0,12">
                            <TextBox Header="Technical Knowledge (10)"
                                     Text="{x:Bind ViewModel.TechnicalKnowledge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Score out of 10" />
                        </Border>
                        <Border Grid.Row="6" Grid.Column="2" BorderThickness="3,0,0,0"
                                BorderBrush="{StaticResource ManualFieldBrush}" Padding="8,0,0,0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Recommendation" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          x:Name="RecommendCombo"
                                          ItemsSource="{x:Bind ViewModel.RecommendationOptions, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Final Status | Joining Date -->
                        <Border Grid.Row="7" Grid.Column="0" BorderThickness="3,0,0,0"
                                BorderBrush="{StaticResource ManualFieldBrush}" Padding="8,0,0,0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Final Status" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          x:Name="FinalStatusCombo"
                                          ItemsSource="{x:Bind ViewModel.FinalStatusOptions, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="7" Grid.Column="2" BorderThickness="3,0,0,0"
                                BorderBrush="{StaticResource ManualFieldBrush}" Padding="8,0,0,0" Margin="0,0,0,12">
                            <TextBox Header="Joining Date" PlaceholderText="YYYY-MM-DD"
                                     Text="{x:Bind ViewModel.JoiningDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>

                        <!-- Interviewer | Remarks -->
                        <Border Grid.Row="8" Grid.Column="0" BorderThickness="3,0,0,0"
                                BorderBrush="{StaticResource ManualFieldBrush}" Padding="8,0,0,0" Margin="0,0,0,0">
                            <TextBox Header="Interviewer"
                                     Text="{x:Bind ViewModel.Interviewer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Interviewer name" />
                        </Border>
                        <Border Grid.Row="8" Grid.Column="2" BorderThickness="3,0,0,0"
                                BorderBrush="{StaticResource ManualFieldBrush}" Padding="8,0,0,0" Margin="0,0,0,0">
                            <TextBox Header="Remarks"
                                     Text="{x:Bind ViewModel.Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Additional notes"
                                     AcceptsReturn="True" Height="72" TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Success / Error InfoBars -->
            <InfoBar Grid.Row="3"
                     IsOpen="{x:Bind ViewModel.HasSuccess, Mode=OneWay}"
                     Severity="Success"
                     Title="Saved Successfully"
                     Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
                     Margin="0,0,0,8" />

            <InfoBar Grid.Row="4"
                     IsOpen="{x:Bind ViewModel.HasSubmitError, Mode=OneWay}"
                     Severity="Error"
                     Title="Save Failed"
                     Message="{x:Bind ViewModel.SubmitErrorMessage, Mode=OneWay}"
                     Margin="0,0,0,8" />

            <!-- Action Buttons -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <Button Content="Clear Form" Command="{x:Bind ViewModel.ClearFormCommand}" />
                <Button x:Name="SubmitButton" Click="SubmitButton_Click"
                        Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="SubmitRing"
                                      IsActive="{x:Bind ViewModel.IsSubmitting, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsSubmitting, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                      Width="16" Height="16" Foreground="White" />
                        <TextBlock x:Name="SubmitText" Text="Submit Interview" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

