<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InterviewTracker.Views.CandidateDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:InterviewTracker.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:StatusToBrushConverter x:Key="StatusToBrush" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Click="BackButton_Click" Margin="0,0,12,0"
                        Style="{ThemeResource DefaultButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        <TextBlock Text="Back" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Candidate Details" Style="{ThemeResource TitleLargeTextBlockStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Click="WhatsAppButton_Click" Background="#25D366" Foreground="White">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="WhatsApp" />
                        </StackPanel>
                    </Button>
                    <Button Click="EditButton_Click" Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                            <TextBlock Text="Edit" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Loading / Error -->
            <StackPanel Grid.Row="1">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                              HorizontalAlignment="Center" Width="48" Height="48" Margin="0,20,0,20" />
                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         Severity="Error" Title="Error"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                         Margin="0,0,0,12" />
            </StackPanel>

            <!-- Detail sections -->
            <StackPanel Grid.Row="2" Spacing="16"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">

                <!-- Interview Details -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Interview Details" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Interview ID" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Candidate.InterviewId, Mode=OneWay}"
                                           Style="{StaticResource FieldValueStyle}" FontWeight="Bold" FontSize="18" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Interview Date" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Candidate.InterviewDate, Mode=OneWay}"
                                           Style="{StaticResource FieldValueStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Interviewer" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Candidate.Interviewer, Mode=OneWay}"
                                           Style="{StaticResource FieldValueStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Candidate Details -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Candidate Details" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Candidate Name" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Candidate.CandidateName, Mode=OneWay}"
                                           Style="{StaticResource FieldValueStyle}" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                <TextBlock Text="Mobile No." Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Candidate.MobileNo, Mode=OneWay}"
                                           Style="{StaticResource FieldValueStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Current Location" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Candidate.CurrentLocation, Mode=OneWay}"
                                           Style="{StaticResource FieldValueStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Education / Qualification" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Candidate.EducationQualification, Mode=OneWay}"
                                           Style="{StaticResource FieldValueStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="Total Experience (Years)" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Candidate.TotalExperienceYears, Mode=OneWay}"
                                           Style="{StaticResource FieldValueStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Position Applied For" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Candidate.PositionAppliedFor, Mode=OneWay}"
                                           Style="{StaticResource FieldValueStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Salary Details -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Salary Details" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Current Salary" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Candidate.CurrentSalary, Mode=OneWay}"
                                           Style="{StaticResource FieldValueStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Expected Salary" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Candidate.ExpectedSalary, Mode=OneWay}"
                                           Style="{StaticResource FieldValueStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Notice Period" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Candidate.NoticePeriod, Mode=OneWay}"
                                           Style="{StaticResource FieldValueStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Interview Assessment -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Interview Assessment" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Technical Knowledge (10)" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Candidate.TechnicalKnowledge, Mode=OneWay}"
                                           Style="{StaticResource FieldValueStyle}" FontSize="20" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Recommendation" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Candidate.Recommendation, Mode=OneWay}"
                                           Style="{StaticResource FieldValueStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Final Status" Style="{StaticResource FieldLabelStyle}" />
                                <Border CornerRadius="6" Padding="12,4"
                                        HorizontalAlignment="Left"
                                        Background="{x:Bind ViewModel.Candidate.FinalStatus, Mode=OneWay, Converter={StaticResource StatusToBrush}}">
                                    <TextBlock Text="{x:Bind ViewModel.Candidate.FinalStatus, Mode=OneWay}"
                                               Foreground="White" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Final Decision -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Final Decision" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Joining Date" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Candidate.JoiningDate, Mode=OneWay}"
                                           Style="{StaticResource FieldValueStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Joining Availability" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Candidate.JoiningAvailability, Mode=OneWay}"
                                           Style="{StaticResource FieldValueStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Department" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Candidate.Department, Mode=OneWay}"
                                           Style="{StaticResource FieldValueStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Resume & Remarks -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Resume" Style="{StaticResource SectionHeaderStyle}" />
                        <HyperlinkButton Click="ResumeButton_Click"
                                         Visibility="{x:Bind ViewModel.Candidate.ResumeUrl, Mode=OneWay, Converter={StaticResource StringToVisibility}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A5;" FontSize="16" />
                                <TextBlock Text="Open Resume in Google Drive" />
                            </StackPanel>
                        </HyperlinkButton>
                        <TextBlock Text="No resume uploaded"
                                   Visibility="{x:Bind ViewModel.Candidate.ResumeUrl, Mode=OneWay, Converter={StaticResource StringToVisibility}, ConverterParameter=invert}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="Remarks" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,0" />
                        <TextBlock Text="{x:Bind ViewModel.Candidate.Remarks, Mode=OneWay}"
                                   Style="{StaticResource FieldValueStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

