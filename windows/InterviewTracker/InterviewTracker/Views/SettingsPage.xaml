<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InterviewTracker.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:InterviewTracker.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,16,24,32" MaxWidth="900" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Settings" Style="{ThemeResource TitleLargeTextBlockStyle}" />
                <TextBlock
                    Text="Application configuration and backend connection diagnostics"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Margin="0,4,0,0" />
            </StackPanel>

            <!-- Content -->
            <StackPanel Grid.Row="1" Spacing="20">
                <!-- API Connection Card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Backend API Configuration" Style="{StaticResource SectionHeaderStyle}" />

                        <TextBox
                            Header="Apps Script Web App URL"
                            Text="{x:Bind ViewModel.ApiBaseUrl, Mode=OneWay}"
                            IsReadOnly="True" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                Header="WhatsApp Notification Number"
                                Text="{x:Bind ViewModel.WhatsAppNumber, Mode=OneWay}"
                                IsReadOnly="True" />
                            <TextBox
                                Grid.Column="1"
                                Header="Max PDF Upload Size"
                                Text="20 MB"
                                IsReadOnly="True" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                Content="⚡  Test Backend Connection"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="TestConnection_Click"
                                IsEnabled="{x:Bind ViewModel.IsTestingConnection, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                            <ProgressRing
                                IsActive="{x:Bind ViewModel.IsTestingConnection, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsTestingConnection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Width="24" Height="24" />
                        </StackPanel>

                        <InfoBar
                            x:Name="ConnectionInfoBar"
                            IsOpen="{x:Bind ViewModel.HasTestResult, Mode=OneWay}"
                            Title="{x:Bind ViewModel.TestResultTitle, Mode=OneWay}"
                            Message="{x:Bind ViewModel.TestResultMessage, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- System Info Card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="System Information" Style="{StaticResource SectionHeaderStyle}" />

                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="App Version" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.AppVersion}" FontWeight="SemiBold" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text=".NET Runtime" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.DotNetVersion}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Operating System" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.OsVersion}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Google Sheet ID" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="1oFCdVS50HLpAbj19Utl7Df9ct-SUdWf2eDuUyedAghg (GID: 1604294621)" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Security Assurance -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Security &amp; Privacy Notice" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock
                            Text="• Gemini API key is stored exclusively in Apps Script Script Properties on Google's secure servers.&#x0a;• This desktop client contains zero API keys or credentials.&#x0a;• PDF resumes are processed directly by Gemini and saved to Drive only upon confirmed submission."
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
